# Copier en .env et remplir. Ne jamais committer le .env.
DEBUG=True
DJANGO_SECRET_KEY=
QR_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Nombre de reverse proxies de confiance (lecture de X-Forwarded-For pour l'anti-accaparement par IP).
NUM_PROXIES=0

DB_NAME=mon_ticket
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Laisser vide : Paystack signe les webhooks avec la cle secrete du compte.
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CURRENCY=XOF

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Mon Ticket <no-reply@monticket.app>
